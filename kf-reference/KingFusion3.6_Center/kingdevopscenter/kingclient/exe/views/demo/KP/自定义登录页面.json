Storage.getItem('Pswd');\r\n\r\n// 检查是否都存在用户名和密码\r\nif (user !== \"\" && pswd !== \"\") {\r\n    // 设置用户名和密码输入框的数值\r\n    UserName.SetInputValue(user);\r\n    PassWorld.SetInputValue(pswd);\r\n    // 检查复选框以指示已保存的凭据\r\n    checkbox1.SetCheckState(0, true);\r\n} else {\r\n    // 如果没有找到保存的凭据，则取消选中复选框\r\n    checkbox1.SetCheckState(0, false);\r\n}\r\n\r\n// 在按键弹起事件上执行的函数\r\nkeyupFunc = function(e){\r\n    // 如果按下的是回车键\r\n    if(e.keyCode === 13){\r\n        // 将登录变量设置为false\r\n        $Variable.login = false;\r\n    }\r\n}\r\n\r\n// 将按键弹起事件监听器添加到文档上\r\ndocument.addEventListener('keyup',keyupFunc);"},{"linkId":2,"enable":false,"script":"","intervalMs":1000},{"linkId":4,"enable":false,"script":""},{"linkId":1001,"enable":true,"script":"debugger\r\n// 获取复选框状态\r\nvar Status = checkbox1.GetCheckState(0);\r\n\r\n// 获取用户名和密码输入框的值\r\nvar user = UserName.GetInputValue();\r\nvar pswd = PassWorld.GetInputValue();\r\n\r\n// 调用登录函数，并传入用户名、密码以及回调函数\r\nLogin(user, pswd, function (res) {\r\n    // 如果登录结果为成功\r\n    if (res.result) {\r\n        // 输出登录结果到控制台\r\n        console.log(res);\r\n        // 如果复选框被选中\r\n        if (Status) {\r\n            // 将用户名和密码存储到localStorage中\r\n            localStorage.setItem('User', user);\r\n            localStorage.setItem('Pswd', pswd);\r\n        } else {\r\n            // 清除localStorage中的用户名和密码\r\n            localStorage.setItem('User', '');\r\n            localStorage.setItem('User', '');\r\n        }\r\n        // 移除按键弹起事件监听器\r\n        document.removeEventListener('keyup',keyupFunc);\r\n        // 将按键弹起事件函数设为null\r\n        keyupFunc = null;\r\n        //跳转到首页'main'\r\n        ShowPage('main')\r\n    } else {\r\n        // 如果登录结果为失败，则弹出提示框\r\n        alert('请输入正确的用户名或密码！！！');\r\n    }\r\n});","name":"login"}]},"variable":[{"name":"login","dataType":0,"comment":"","defaultValue":true,"accessType":0,"linkInfo":""}],"dataSourceMng":[],"customProperty":[],"pagePrototype":{"name":"login","guid":"k659e278f-4dca-4f1f-a349-18c4e395c6f2","version":"2.0.0.1.274","type":6},"pageWindowInfo":{"pageOptions":{"pageTitle":"","pageClose":true,"pageMax":true,"pageMin":false,"pageResizable":true},"pageScroll":false,"pageWindowType":0,"pageWindowCss":""},"pageViewWidth":1990,"pageViewHeight":1599}