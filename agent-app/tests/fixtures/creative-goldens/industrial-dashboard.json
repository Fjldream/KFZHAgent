      {
        "id": "industrial-filter-script",
        "purpose": "读取状态条件并把主设备网格刷新为一条需关注记录",
        "kind": "custom",
        "programVersion": "semantic-js/v1",
        "source": "const status = $control.getValue(\"industrial-filter-input\");\nconst records = [{ \"equipmentCode\": \"CNC-07\", \"line\": \"精加工一线\", \"name\": \"七号数控单元\", \"status\": String(status), \"temperature\": 67.4, \"alarm\": \"主轴振动偏高\" }];\n$control.setData(\"industrial-main-grid\", records);",
        "inputs": [{ "name": "equipment-status-filter", "description": "设备状态筛选条件", "refKind": "control", "refId": "industrial-filter-input" }],
        "outputs": [{ "name": "filtered-equipment-records", "description": "筛选后的主设备记录", "refKind": "control", "refId": "industrial-main-grid" }]
      },
      {
        "id": "industrial-row-detail-script",
        "purpose": "读取主设备网格当前行并通过同构记录写入侧栏详情网格",
        "kind": "custom",
        "programVersion": "semantic-js/v1",
        "source": "const selectedRecord = $event.record();\nconst records = [];\nrecords.push(selectedRecord);\n$control.setData(\"industrial-detail-grid\", records);",
        "inputs": [],
        "outputs": [{ "name": "selected-equipment-detail", "description": "当前选中设备的同构详情记录", "refKind": "control", "refId": "industrial-detail-grid" }]
      }
    ]
