    "scripts": [
      {
        "id": "admin-filter-members-script",
        "purpose": "读取姓名条件并把成员主列表刷新为陈予安记录",
        "kind": "custom",
        "programVersion": "semantic-js/v1",
        "source": "const name = $control.getValue(\"admin-member-filter-input\");\nconst records = [{ \"id\": \"U-1024\", \"name\": String(name), \"department\": \"产品设计部\", \"role\": \"部门管理员\", \"status\": \"在职\" }];\n$control.setData(\"admin-member-grid\", records);",
        "inputs": [{ "name": "member-name-filter", "description": "成员姓名条件", "refKind": "control", "refId": "admin-member-filter-input" }],
        "outputs": [{ "name": "filtered-member-records", "description": "条件应用后的成员记录", "refKind": "control", "refId": "admin-member-grid" }]
      },
      {
        "id": "admin-select-member-script",
        "purpose": "读取成员主列表当前行并同步到右侧同构预览",
        "kind": "custom",
        "programVersion": "semantic-js/v1",
        "source": "const selectedRecord = $event.record();\nconst records = [];\nrecords.push(selectedRecord);\n$control.setData(\"admin-member-preview-grid\", records);",
        "inputs": [],
        "outputs": [{ "name": "selected-member-preview", "description": "当前成员的同构预览记录", "refKind": "control", "refId": "admin-member-preview-grid" }]
      },
      {
        "id": "admin-tab-activity-script",
        "purpose": "页签响应时写入当前成员的一条最新操作记录",
        "kind": "custom",
        "programVersion": "semantic-js/v1",
        "source": "const records = [{ \"id\": \"A-205\", \"time\": \"2026-08-26 09:20\", \"action\": \"复核部门管理员权限\", \"operator\": \"王敏\" }];\n$control.setData(\"admin-activity-grid\", records);",
        "inputs": [],
        "outputs": [{ "name": "member-activity-view", "description": "页签响应后的成员操作记录", "refKind": "control", "refId": "admin-activity-grid" }]
      },
      {
        "id": "admin-submit-script",
        "purpose": "读取并清理复核姓名后写入成员资料提交成功状态",
        "kind": "custom",
        "programVersion": "semantic-js/v1",
        "source": "const name = $control.getValue(\"admin-dialog-name-input-overlay-copy\");\nconst normalizedName = String(name).trim();\nconst records = [{ \"id\": \"S-1\", \"object\": String(normalizedName), \"status\": \"提交成功\", \"operator\": \"王敏\" }];\n$control.setData(\"admin-submit-status-grid-overlay-copy\", records);",
        "inputs": [{ "name": "reviewed-member-name", "description": "对话层复核后的成员姓名", "refKind": "control", "refId": "admin-dialog-name-input-overlay-copy" }],
        "outputs": [{ "name": "member-submit-status", "description": "成员资料提交状态记录", "refKind": "control", "refId": "admin-submit-status-grid-overlay-copy" }]
      }
    ]
