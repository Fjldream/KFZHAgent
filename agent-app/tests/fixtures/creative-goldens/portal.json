{
  "id": "portal",
  "prompt": "创建一个中文建筑与空间摄影作品门户，以编辑叙事、大片与非对称留白展示品牌、精选作品、项目详情和联系反馈。",
  "expect": {},
  "blueprint": {
    "schema": "kf-design-plan/v3",
    "displayName": "叠境空间影像",
    "objective": "以媒体主导的编辑叙事帮助潜在客户浏览代表作品、理解项目语境并提交合作意向",
    "audiences": ["品牌与建筑事务所客户", "展览策划人"],
    "scenarios": ["浏览精选空间影像", "查看项目叙事", "提交拍摄合作意向"],
    "pages": [
      {
        "id": "portal-home-bp",
        "title": "叠境首页",
        "purpose": "用品牌引言、大幅主视觉和非对称精选作品序列建立第一印象",
        "readingOrder": ["portal-nav", "portal-nav-action", "portal-hero", "portal-gallery"],
        "regions": [
          {
            "id": "portal-nav",
            "purpose": "提供品牌识别和作品、联系目的地入口",
            "semanticRoles": ["heading", "primary-action", "secondary-action"],
            "dataShape": "scalar",
            "density": "comfortable",
            "importance": "secondary",
            "content": ["叠境空间影像", "精选作品", "联系"],
            "sampleData": [],
            "interactions": ["作品入口响应并切换项目页"],
            "states": ["首页可浏览"],
            "visualIntent": "克制的顶部文字导航与宽阔横向留白"
          },
          {
            "id": "portal-hero",
            "purpose": "以一幅大尺度空间影像和短篇品牌宣言建立编辑叙事",
            "semanticRoles": ["media", "heading", "narrative-content", "primary-action"],
            "dataShape": "media-list",
            "density": "spacious",
            "importance": "primary",
            "content": ["让光线成为空间的第二层结构", "上海 · 建筑与空间影像"],
            "sampleData": [{ "项目": "海岸书屋", "地点": "秦皇岛" }],
            "interactions": [],
            "states": ["品牌主视觉已呈现"],
            "visualIntent": "超大画面、偏置文案和明显不对称留白"
          },
          {
            "id": "portal-nav-action",
            "purpose": "在顶部导航中提供一个进入精选项目的明确动作",
            "semanticRoles": ["primary-action"],
            "dataShape": "action-list",
            "density": "comfortable",
            "importance": "secondary",
            "content": ["精选作品"],
            "sampleData": [],
            "interactions": ["顶部作品入口响应"],
            "states": ["顶部导航可用"],
            "visualIntent": "与品牌字标同线但保持低干扰"
          },
          {
            "id": "portal-gallery",
            "purpose": "用不同画幅与节奏的真实作品缩略影像形成精选作品画廊",
            "semanticRoles": ["media", "product-visual", "heading", "primary-action"],
            "dataShape": "media-list",
            "density": "spacious",
            "importance": "primary",
            "content": ["北境艺廊", "山谷民宿", "海岸书屋"],
            "sampleData": [
              { "作品": "北境艺廊", "地点": "北京", "年份": "2026" },
              { "作品": "山谷民宿", "地点": "莫干山", "年份": "2025" }
            ],
            "interactions": ["作品焦点响应并切换完整项目页"],
            "states": ["精选作品可选择"],
            "visualIntent": "避免等宽卡片，用一大两小的非对称媒体编排"
          }
        ]
      },
      {
        "id": "portal-detail-bp",
        "title": "北境艺廊详情",
        "purpose": "呈现单个作品的大画面、设计语境和合作联系层",
        "readingOrder": ["portal-detail-nav", "portal-detail", "portal-contact-form", "portal-contact-submit", "portal-contact-status", "portal-contact-close"],
        "regions": [
          {
            "id": "portal-detail-nav",
            "purpose": "提供从单个作品回到精选作品序列的明确回程动作",
            "semanticRoles": ["secondary-action"],
            "dataShape": "action-list",
            "density": "comfortable",
            "importance": "secondary",
            "content": ["返回精选作品"],
            "sampleData": [],
            "interactions": ["回程入口响应"],
            "states": ["回程动作可用"],
            "visualIntent": "单一文字动作贴近页面左上边界"
          },
          {
            "id": "portal-detail",
            "purpose": "以横向主图、项目标题和简短拍摄笔记讲述北境艺廊",
            "semanticRoles": ["media", "heading", "narrative-content", "secondary-action"],
            "dataShape": "record",
            "density": "spacious",
            "importance": "primary",
            "content": ["北境艺廊", "晨光把清水混凝土切成缓慢移动的几何面", "返回作品"],
            "sampleData": [{ "地点": "北京顺义", "面积": "3200 平方米", "拍摄": "2026 年 4 月" }],
            "interactions": ["回程入口响应并切换作品首页"],
            "states": ["项目详情可阅读"],
            "visualIntent": "单一大图承担主视觉，文字沿窄列下沉"
          },
          {
            "id": "portal-contact-form",
            "purpose": "在作品语境内收集一条合作留言并提交",
            "semanticRoles": ["form-input", "primary-action"],
            "dataShape": "record",
            "density": "comfortable",
            "importance": "supporting",
            "content": ["合作留言", "提交意向"],
            "sampleData": [{ "联系人": "林悦", "机构": "栖居设计研究室", "意向": "秋季酒店拍摄" }],
            "interactions": ["输入合作意向并提交"],
            "states": ["联系层已打开"],
            "visualIntent": "轻量覆盖层与首页大片形成尺度对比"
          },
          {
            "id": "portal-contact-status",
            "purpose": "紧凑呈现合作留言的当前处理状态",
            "semanticRoles": ["structured-record-list", "status-label"],
            "dataShape": "record-list",
            "density": "comfortable",
            "importance": "supporting",
            "content": ["合作留言", "已收到"],
            "sampleData": [{ "留言": "秋季酒店拍摄合作", "状态": "已收到" }],
            "interactions": [],
            "states": ["提交状态可见"],
            "visualIntent": "一行状态记录，不形成主页面表格感"
          },
          {
            "id": "portal-contact-submit",
            "purpose": "提交当前联系留言并触发状态反馈",
            "semanticRoles": ["primary-action"],
            "dataShape": "action-list",
            "density": "comfortable",
            "importance": "supporting",
            "content": ["提交合作意向"],
            "sampleData": [],
            "interactions": ["提交动作响应"],
            "states": ["提交动作可用"],
            "visualIntent": "覆盖层内唯一高强调动作"
          },
          {
            "id": "portal-contact-close",
            "purpose": "提供关闭联系层并回到作品详情的单一动作",
            "semanticRoles": ["secondary-action"],
            "dataShape": "action-list",
            "density": "comfortable",
            "importance": "supporting",
            "content": ["关闭联系层"],
            "sampleData": [],
            "interactions": ["关闭联系层返回作品详情"],
            "states": ["关闭动作可用"],
            "visualIntent": "低强调度的底部回程动作"
          }
        ]
      }
    ],
