  "visualDirection": {
    "tone": "冷静、专业、克制的能源运营工具风格，静态演示基调明确",
    "colors": [
      "页面背景浅灰蓝 #f2f5f7",
      "正文深蓝灰 #1f2a44",
      "强调青绿 #0f7b7b",
      "待检修等警示状态使用暖警示色但不代表真实告警"
    ],
    "typography": "系统原生无衬线字体，指标数值使用最大字重与字号，标签与页脚文字弱化",
    "spacingAndSurfaces": "12/16/24 间距体系，卡片圆角 8-10，卡片浅色底配轻描边，卡片间留白均匀"
  },
  "acceptanceScenarios": [
    "页面顶部可见系统名称、页面标题与“演示数据”标识。",
    "侧栏显示三项菜单文字且点击不产生导航或页面切换。",
    "三张指标卡分别呈现今日用电量、当前总功率、设备在线率及对应单位。",
    "重点设备列表呈现三台设备及状态，其中“光伏逆变器”显示“待检修”。",
    "运行摘要显示当前告警、今日能耗目标、数据更新时间及“查看运行说明”按钮静态外观。",
    "页脚显示“仅用于界面与工程生成验收 · 所有数值均为演示数据”。",
    "整页仅由原生布局与文字构成，未使用整张截图作为背景。"
  ],
  "openQuestions": [
    "“查看运行说明”按钮的点击行为是否后续需要定义，还是长期保持纯静态展示？",
    "侧栏菜单项在实际产品中是否需要导航交互，还是仅作为静态分区展示？",
    "待检修状态的视觉强调是否需要与正式告警色严格区分？"
  ]
}