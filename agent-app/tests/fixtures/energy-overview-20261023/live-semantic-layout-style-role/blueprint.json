{
  "schema": "kf-design-plan/v3",
  "displayName": "园区能源总览 · 静态演示蓝图",
  "objective": "以客户可读的方式呈现园区能源总览页的静态信息结构：顶部标识与演示徽标、静态侧栏、三项关键指标、重点设备状态列表、运行摘要与页脚说明；所有数值均为演示数据，不接业务源，不实现导航或按钮动作。",
  "audiences": [
    "园区能源运营人员",
    "能源管理平台产品与设计评审方",
    "界面工程生成验收方"
  ],
  "scenarios": [
    "快速了解园区当日用电、当前功率与设备在线率",
    "浏览重点设备的运行状态与待检修项",
    "查看运行摘要中的告警数量、能耗目标与数据更新时间",
    "确认页面为演示数据且侧栏仅静态展示"
  ],
