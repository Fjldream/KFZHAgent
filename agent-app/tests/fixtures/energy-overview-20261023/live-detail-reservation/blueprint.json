  "journeys": [
    {
      "id": "read-overview-metrics",
      "actor": "园区能源运营人员",
      "goal": "快速获知核心能耗指标数值",
      "steps": [
        {
          "pageId": "overview",
          "regionId": "page-heading",
          "action": "阅读页面标题与说明",
          "result": "确认当前为园区能源总览页并了解浏览范围",
          "kind": "observe",
          "expectedTexts": [
            "能源总览",
            "掌握园区用能与设备运行状态"
          ]
        },
        {
          "pageId": "overview",
          "regionId": "metric-cards",
          "action": "阅读三张指标卡的数值与单位",
          "result": "获知演示口径下的今日用电量、当前总功率与设备在线率",
          "kind": "observe",
          "expectedTexts": [
            "今日用电量",
            "12,480",
            "kWh",
            "当前总功率",
            "856",
            "kW",
            "设备在线率",
            "98.6",
            "%"
          ]
        }
      ]
    },
    {
      "id": "review-device-status",
      "actor": "设施运维管理人员",
      "goal": "查看重点设备当前状态",
      "steps": [
        {
          "pageId": "overview",
          "regionId": "detail-panels",
          "action": "阅读重点设备面板各行设备名称与状态",
          "result": "了解三台重点设备的演示状态，包括一台待检修设备",
          "kind": "observe",
          "expectedTexts": [
            "重点设备",
            "1号配电室",
            "运行正常",
            "中央空调",
            "光伏逆变器",
            "待检修"
          ]
        }
      ]
    },
    {
      "id": "review-summary-and-limits",
      "actor": "界面与工程验收评审人",
      "goal": "确认运行摘要内容与演示数据限制",
      "steps": [
        {
          "pageId": "overview",
          "regionId": "detail-panels",
          "action": "阅读运行摘要各条目标签与数值及按钮文字",
          "result": "确认告警数量、能耗目标、更新时间与静态按钮外观",
          "kind": "observe",
          "expectedTexts": [
            "运行摘要",
            "当前告警",
            "2",
            "项",
            "今日能耗目标",
            "15,000",
            "数据更新时间",
            "14:30",
            "查看运行说明"
          ]
        },
        {
          "pageId": "overview",
          "regionId": "app-footnote",
          "action": "阅读页脚说明与页头演示数据标记",
          "result": "确认页面数值仅为演示数据，不接业务源",
          "kind": "observe",
          "expectedTexts": [
            "仅用于界面与工程生成验收 · 所有数值均为演示数据",
            "演示数据"
          ]
        }
      ]
    }
  ],
  "visualDirection": {
    "tone": "冷静、清晰、克制的企业能源运营风格，强调可读性与信息层级",
    "colors": [
      "#eef3f7 页面背景",
      "#1b2a33 主要文字",
      "#0f8f8c 强调色",
      "白色卡片表面",
      "浅灰分隔与次要文字"
    ],
    "typography": "标题使用较大字号与较重字重，指标数值最大最突出，标签与单位使用较小字号并弱化颜色",
    "spacingAndSurfaces": "8/12/16/24/32 间距体系，卡片使用 6 至 12 圆角与轻微阴影，白色卡片浮于浅色背景之上"
  },
  "acceptanceScenarios": [
    "总览页静态呈现页头品牌、页面标题与演示数据标记，且不出现导航跳转行为",
    "三张指标卡以演示数值展示今日用电量、当前总功率与设备在线率及其单位",
    "重点设备面板展示三台设备名称与状态，其中一台为待检修",
    "运行摘要面板展示当前告警 2 项、今日能耗目标 15,000 kWh 与数据更新时间 14:30",
    "查看运行说明按钮仅保留静态外观，点击不触发任何动作",
    "页脚展示演示数据说明，且页面不使用整张参考图作为背景"
  ],
  "openQuestions": [
    "查看运行说明按钮被点击后应执行什么行为，当前无法从静态外观确认。",
    "侧栏各导航项的真实目标页面或路由无法从静态外观确认。",
    "演示数值的实际数据来源及刷新方式无法从截图中确认。"
  ]
}