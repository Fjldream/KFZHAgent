{
  "schema": "kf-design-plan/v3",
  "displayName": "园区能源总览静态演示页",
  "objective": "以静态原生客户端形式呈现园区能源总览，展示顶部标题栏、静态侧栏、三项核心指标、重点设备状态、运行摘要与页脚说明；所有数值均为演示数据，不接业务数据源，侧栏不做导航，查看运行说明按钮仅保留静态外观。",
  "audiences": [
    "园区能源管理值守人员",
    "能源运营负责人",
    "到访评审与验收人员"
  ],
  "scenarios": [
    "值守人员快速浏览今日用电量、当前总功率与设备在线率等演示指标",
    "负责人查看重点设备的演示运行状态并识别待检修项",
    "评审人员确认页面结构、层级与静态演示数据说明是否完整清晰"
  ],
