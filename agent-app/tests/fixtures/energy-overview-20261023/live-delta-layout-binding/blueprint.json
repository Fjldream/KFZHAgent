  "visualDirection": {
    "tone": "清爽克制的工业能源管理风格，浅冷色背景配青绿色强调，信息层级清晰，静态演示气质明确。",
    "colors": [
      "背景浅冷灰 #eef3f6",
      "前景深墨绿 #17333b",
      "强调青绿 #0f8a8a"
    ],
    "typography": "标题使用较粗字重与深色前景，指标数值使用大号醒目文字，辅助说明与单位使用较小弱化字号，保持统一行高与对齐。",
    "spacingAndSurfaces": "以 8/16/24/32 为间距节奏，卡片表面使用浅色底与 8/12 圆角，卡片间留白充分，页头、侧栏与主内容通过表面色差区分。"
  },
  "acceptanceScenarios": [
    "页面顶部可读到能源管理系统、园区能源总览与演示数据三项文字。",
    "侧栏可见能源总览、设备监测、告警中心三个静态菜单项，且不产生导航跳转。",
    "三张指标卡分别显示今日用电量 12,480 kWh、当前总功率 856 kW、设备在线率 98.6%。",
    "重点设备卡显示1号配电室运行正常、中央空调运行正常、光伏逆变器待检修。",
    "运行摘要卡显示当前告警 2 项、今日能耗目标 15,000 kWh、数据更新时间 14:30。",
    "查看运行说明按钮文字可见，但仅有静态外观，无未经确认的点击动作。",
    "页脚显示仅用于界面与工程生成验收 · 所有数值均为演示数据。",
    "页面不使用整张参考截图作为背景，各文字区域保持独立且父容器不重复子节点文字。"
  ],
  "openQuestions": [
    "侧栏菜单项的选中态与图标精确样式是否需要保留？",
    "查看运行说明按钮最终点击行为未在图中体现，需要确认。",
    "除演示数据外的真实数据来源与刷新机制未知。",
    "侧栏在原生客户端中是否需要固定宽度与固定位置？"
  ]
}