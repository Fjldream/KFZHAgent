{
  "schema": "kf-design-plan/v3",
  "displayName": "园区能源总览静态演示页",
  "objective": "以原生客户端静态界面呈现园区能源总览的关键指标、重点设备状态与运行摘要，所有数值均为演示数据；侧栏仅静态展示不导航，查看运行说明按钮仅保留静态外观，本蓝图仅用于展示与下一步独立确认。",
  "audiences": [
    "园区能源运维人员",
    "设施管理负责人",
    "界面与工程验收评审人员"
  ],
  "scenarios": [
    "打开客户端查看园区今日用电量、当前总功率与设备在线率",
    "浏览重点设备列表，识别运行正常与待检修设备",
    "查看运行摘要中的告警数量、能耗目标与数据更新时间",
    "评审静态演示页的层级、信息顺序与视觉基调"
  ],
