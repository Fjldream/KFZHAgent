      "#eef2f5 背景",
      "#1a1a1a 文字",
      "#0a7b78 主色强调",
      "#ffffff 卡片表面"
    ],
    "typography": "标题使用较大加粗深色字，指标数值加大加粗，标签与辅助说明使用小号浅灰字",
    "spacingAndSurfaces": "8/16/24 间距节奏，白色圆角卡片承载内容，卡片间均匀留白，侧栏与内容区明确分区。"
  },
  "acceptanceScenarios": [
    "打开静态总览页，顶部可见能源管理系统、园区能源总览与演示数据三项文字",
    "内容区可见三张指标卡片，分别显示今日用电量12,480 kWh、当前总功率856 kW、设备在线率98.6%",
    "重点设备列表显示三项设备名称及运行正常、运行正常、待检修状态",
    "运行摘要显示当前告警2项、今日能耗目标15,000 kWh、数据更新时间14:30",
    "查看运行说明按钮以静态整宽按钮外观呈现，点击不触发任何动作",
    "侧栏三项入口文字静态展示，点击不发生导航或选中变化",
    "页面未使用整张参考截图作为背景，各文字区域独立呈现"
  ],
  "openQuestions": [
    "点击“查看运行说明”按钮后应显示什么内容或触发何种行为？",
    "侧栏导航项是否需要选中、悬停等交互状态？",
    "页面数据的刷新频率和真实数据来源是什么？",
    "当前项“能源总览”是否需要独立的静态选中样式以区分其他入口？"
  ]
}