  "visualDirection": {
    "tone": "冷静、专业、可信赖的工业能源运营气质，信息密度适中，强调数据可读性",
    "colors": [
      "背景浅灰蓝 #eef3f7",
      "主文字深蓝灰 #1b2733",
      "强调青绿 #00857a",
      "卡片白底",
      "状态色点按运行/待检修区分"
    ],
    "typography": "标题字重较大、层级分明；指标数值使用最大字号；标签与说明使用较小号中性色文字；单位弱化显示",
    "spacingAndSurfaces": "基于 8/16/24/32 间距体系，卡片圆角 4 至 8，白色卡片浮于浅灰蓝背景之上，卡片间留白均匀，整体大留白、弱边框"
  },
  "acceptanceScenarios": [
    "页面以单个静态总览页呈现，包含头部、侧栏、页面说明、三张指标卡、重点设备卡、运行摘要卡与底部声明，不出现缺块或错位。",
    "三张指标卡分别显示今日用电量 12,480 kWh、当前总功率 856 kW、设备在线率 98.6%。",
    "重点设备卡显示 1号配电室（运行正常）、中央空调（运行正常）、光伏逆变器（待检修）三行。",
    "运行摘要卡显示当前告警 2 项、今日能耗目标 15,000 kWh、数据更新时间 14:30，并含整宽查看运行说明按钮外观。",
    "侧栏三项与查看运行说明按钮仅为静态外观，点击不产生导航或任何动作。",
    "页面未被整张参考截图作为背景，文字均为独立静态文字元素，父容器不重复子节点文字。",
    "底部显示仅用于界面与工程生成验收 · 所有数值均为演示数据。"
  ],
  "openQuestions": [
    "侧栏导航项是否为真实可交互控件及其目标页面仍未确认，本蓝图仅保留静态外观。",
    "查看运行说明按钮的点击行为与目标内容未确认，是否需要后续绑定待定。",
    "演示数据的刷新方式与数据更新时间语义未确认，是否需要展示自动更新标识待定。"
  ]
