  "visualDirection": {
    "tone": "克制、清晰、偏工业能源运维风格的静态总览，强调可读层级而非装饰。",
    "colors": [
      "页面背景 #f2f6f8",
      "正文文字 #111827",
      "强调色 #0d8a8a",
      "卡片浅色表面用于指标与摘要分区"
    ],
    "typography": "标题使用较大字重形成层级，指标数值为页内最大字号，单位与说明文字使用小字号弱化处理。",
    "spacingAndSurfaces": "基于 8/12/16/24/32 的间距节奏，卡片使用 6/8/12 圆角与浅色表面，卡片之间留白充足，整体保持静态平铺不叠加整图背景。"
  },
  "acceptanceScenarios": [
    "页面完整呈现顶部标识、页面标题与演示数据标记，且无任何导航行为。",
    "侧栏三个目录标签仅静态展示，点击不产生跳转或状态切换。",
    "三张指标卡片分别展示今日用电量 12,480 kWh、当前总功率 856 kW、设备在线率 98.6%。",
    "重点设备卡片展示 1号配电室运行正常、中央空调运行正常、光伏逆变器待检修。",
    "运行摘要展示当前告警 2 项、今日能耗目标 15,000 kWh、数据更新时间 14:30。",
    "查看运行说明按钮仅保留静态外观，不触发内容展示或任何动作。",
    "页脚声明“仅用于界面与工程生成验收 · 所有数值均为演示数据”可见。",
    "页面不以整张参考截图作为背景，各文字区域独立呈现且父容器不重复子节点文字。"
  ],
  "openQuestions": [
    "查看运行说明按钮被点击后应展示什么内容或触发什么行为？当前蓝图仅保留静态外观。",
    "侧栏导航项是否需要支持交互跳转，还是仅作静态展示？当前蓝图按静态展示处理。",
    "静态页面是否需要适配较小窗口尺寸的换行或压缩展示策略？"
  ]
}