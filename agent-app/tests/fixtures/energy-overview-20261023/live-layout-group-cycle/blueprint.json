  "visualDirection": {
    "tone": "清爽、克制、信息优先的能源运营控制台风格，所有数值明确标注为演示数据。",
    "colors": [
      "页面背景 #f0f5f5",
      "主要文字 #14201f",
      "强调色 #0f8a83",
      "卡片表面浅白",
      "弱化边框与分隔线"
    ],
    "typography": "标题加粗分层，指标数值大号加粗，名称与单位小号弱化，保证静态文字清晰可读。",
    "spacingAndSurfaces": "采用8/16/24间距节奏与8/12圆角；卡片为浅白表面配细边框与轻阴影，卡片间留白充足但不松散。"
  },
  "acceptanceScenarios": [
    "打开总览页可看到页头三处静态文字：能源管理系统、园区能源总览、演示数据。",
    "侧栏仅显示能源总览、设备监测、告警中心三项文字，点击或悬停不产生导航或状态变化。",
    "三张指标卡片分别显示今日用电量12,480 kWh、当前总功率856 kW、设备在线率98.6 %。",
    "重点设备卡片显示三项设备及状态，其中光伏逆变器为待检修。",
    "运行摘要卡片显示当前告警2项、今日能耗目标15,000 kWh、数据更新时间14:30。",
    "查看运行说明按钮仅呈现静态外观，点击不触发任何动作。",
    "页脚显示仅用于界面与工程生成验收 · 所有数值均为演示数据。",
    "页面未引用整张截图作为背景，各文字区域保持独立层级且父容器不重复子节点文字。"
  ],
  "openQuestions": [
    "侧栏选中高亮是否需要随悬停或点击变化？",
    "查看运行说明按钮的真实点击行为是什么？",
    "演示数据标识是否需要额外的悬浮提示或说明内容？",
    "后续是否需要接入真实业务数据源，以及数据刷新频率？"
  ]
}