{
  "schema": "kf-design-plan/v3",
  "displayName": "园区能源总览静态演示蓝图",
  "objective": "在原生客户端中呈现一个纯静态的园区能源总览页：所有指标、设备状态和运行摘要均为演示数据，仅作界面与后续工程验收展示；侧栏只作静态外观，不提供导航，查看运行说明按钮保持静态外观且不添加动作。",
  "audiences": [
    "园区能源运营人员（演示评审）",
    "界面与工程验收评审者"
  ],
  "scenarios": [
    "评审者打开总览页，通过静态文字快速了解园区用能、设备与告警概况",
    "评审者确认侧栏与按钮仅为静态展示、无跳转和无数据源绑定",
    "评审者核对演示数据标注与页脚说明，明确数值非生产数据"
  ],
