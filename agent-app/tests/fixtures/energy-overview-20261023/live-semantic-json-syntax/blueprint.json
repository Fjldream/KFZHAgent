  "visualDirection": {
    "tone": "清爽、克制的企业级能源运营界面，浅色底与主色青绿点缀，强调数据可读性。",
    "colors": [
      "页面背景 #eef3f7",
      "正文前景 #111111",
      "主强调色 #0f8b8d",
      "卡片表面浅色与页面对比区分"
    ],
    "typography": "标题使用较粗字重区分层级，指标数值最大最醒目，正文与说明文字使用常规字重并弱化。",
    "spacingAndSurfaces": "采用 8/12/16/24/32 的间距节奏，卡片圆角 8-12，卡片表面独立浮于浅色背景，区域间留白清晰。"
  },
  "acceptanceScenarios": [
    "页面在静态状态下完整呈现顶部标题、侧栏菜单项、页面标题与副标题、三张指标卡、重点设备三行、运行摘要三行与说明按钮外观及页脚说明。",
    "所有数值均以演示数据呈现，不出现任何真实数据源引用。",
    "侧栏与查看运行说明按钮仅保留静态外观，不产生导航或点击行为。",
    "页面不使用整张参考截图作为背景，各文字区域独立呈现且父容器不重复子节点文字。"
  ],
  "openQuestions": [
    "侧栏在真实应用中是否支持展开/折叠或二级导航？当前仅按静态展示处理。",
    "“查看运行说明”按钮的点击行为与跳转目标是什么？当前仅保留静态外观。",
    "指标数值是否支持点击查看明细或时间范围切换？"
  ]
}