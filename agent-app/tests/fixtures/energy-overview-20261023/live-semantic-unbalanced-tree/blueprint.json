  "visualDirection": {
    "tone": "清爽克制的工业能源管理风格，以信息可读为先，弱化装饰与动态感",
    "colors": [
      "#f0f4f7 页面背景",
      "#22303c 主文字",
      "#0a8f8a 强调色用于数值与按钮块",
      "#ffffff 卡片底色",
      "#8a99a5 辅助说明文字"
    ],
    "typography": "标题使用粗体大字，指标数值使用突出的大号数字，说明与状态标签使用较小常规字重，保持中文无衬线可读性",
    "spacingAndSurfaces": "以8、16、24为间距节奏，卡片使用10圆角与浅色底、低调边界区分层级；主内容区留白充足，侧栏与页脚视觉弱化"
  },
  "acceptanceScenarios": [
    "页面顶部可见能源管理系统、园区能源总览与演示数据三项文字，且均为普通静态文字。",
    "侧栏可见能源总览、设备监测、告警中心三个模块名称，点击不产生跳转或选中态变化。",
    "三张指标卡片分别显示今日用电量 12,480 kWh、当前总功率 856 kW、设备在线率 98.6 %。",
    "重点设备列表显示1号配电室运行正常、中央空调运行正常、光伏逆变器待检修。",
    "运行摘要显示当前告警 2 项、今日能耗目标 15,000 kWh、数据更新时间 14:30。",
    "查看运行说明按钮以静态外观呈现，点击不打开任何内容。",
    "页脚显示仅用于界面与工程生成验收 · 所有数值均为演示数据。",
    "页面不使用整张截图作为背景，所有文字保留为独立可读的静态文字区域。"
  ],
  "openQuestions": [
    "侧栏导航项的选中态与跳转行为是否需要在后续版本中确认？",
    "查看运行说明按钮点击后的目标内容与展示方式尚不明确。",
    "指标数值是否需要标注统计口径或时段范围，目前仅按参考图呈现。"
  ]
}