{
  "schema": "kf-design-plan/v3",
  "displayName": "园区能源总览静态演示蓝图",
  "objective": "基于已确认的能源管理系统参考图，规划一个原生客户端静态总览页：展示园区能源关键指标、重点设备状态与运行摘要；全部数值为演示数据，侧栏与按钮保持静态外观，不接入业务数据源、不实现导航或点击动作。",
  "audiences": [
    "园区能源运营人员",
    "负责园区设备巡检的运维人员",
    "需要对界面与工程生成结果进行验收的产品与设计评审者"
  ],
  "scenarios": [
    "运营人员在总览页快速浏览今日用电量、当前总功率与设备在线率",
    "运维人员查看重点设备及其运行状态标签",
    "评审者确认演示数据标识与静态外观限制，用于界面与工程生成验收"
  ],
