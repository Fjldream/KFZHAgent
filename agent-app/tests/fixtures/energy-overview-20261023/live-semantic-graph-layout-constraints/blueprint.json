  "journeys": [
    {
      "id": "review-overview",
      "actor": "界面范围评审人",
      "goal": "在静态总览页中确认顶部信息、指标卡与设备列表的呈现是否符合已确认结构",
      "steps": [
        {
          "pageId": "overview",
          "regionId": "top-bar",
          "action": "阅读页头区域",
          "result": "确认系统名称、副标题与演示数据标识均可见",
          "kind": "observe",
          "expectedTexts": [
            "能源管理系统",
            "园区能源总览",
            "演示数据"
          ]
        },
        {
          "pageId": "overview",
          "regionId": "side-nav",
          "action": "阅读静态侧栏条目",
          "result": "确认三项入口名称可见且无跳转发生",
          "kind": "observe",
          "expectedTexts": [
            "能源总览",
            "设备监测",
            "告警中心"
          ]
        },
        {
          "pageId": "overview",
          "regionId": "page-heading",
