          "kind": "observe",
          "expectedTexts": [
            "重点设备",
            "1号配电室",
            "运行正常",
            "中央空调",
            "光伏逆变器",
            "待检修"
          ]
        },
        {
          "pageId": "overview",
          "regionId": "summary-card",
          "action": "阅读运行摘要卡片",
          "result": "确认摘要标题、三组标签值对与按钮标签可见",
          "kind": "observe",
          "expectedTexts": [
            "运行摘要",
            "当前告警",
            "2",
            "项",
            "今日能耗目标",
            "15,000",
            "数据更新时间",
            "14:30",
            "查看运行说明"
