{
  "schema": "kf-design-plan/v3",
  "displayName": "园区能源管理系统静态总览蓝图",
  "objective": "呈现仅用于展示的能源管理总览页蓝图：包含页头、静态侧栏、三项核心指标、重点设备状态、运行摘要与页脚说明；所有数值均为演示数据，不接业务源，侧栏不实现导航，查看运行说明按钮仅保留静态外观且不添加动作，不使用整张截图作为背景。",
  "audiences": [
    "园区能源运营负责人",
    "能源管理平台产品与设计评审人",
    "需要确认静态界面范围的项目干系人"
  ],
  "scenarios": [
    "评审人员打开总览页，快速了解今日用电、当前功率与设备在线率的静态呈现方式",
    "评审人员确认重点设备列表与运行摘要的静态信息层级与父子结构",
    "评审人员确认侧栏与按钮在本阶段为纯静态展示，无导航与点击行为"
  ],
