        {
          "pageId": "overview",
          "regionId": "summary-card",
          "action": "观察查看运行说明按钮呈现",
          "result": "按钮以静态外观呈现，不触发任何动作或反馈",
          "kind": "observe",
          "expectedTexts": [
            "查看运行说明"
          ]
        }
      ],
      "completion": "确认侧栏与按钮均无交互行为，静态范围与约定一致。"
