{
  "schema": "kf-design-plan/v3",
  "displayName": "能源管理系统 · 园区能源总览静态蓝图",
  "objective": "以原生客户端静态总览页呈现园区用能关键指标、重点设备状态与运行摘要；所有数值为演示数据，不接业务数据源，侧栏与说明按钮保持静态外观，不代表工程修改已获批准。",
  "audiences": [
    "园区能源运营人员",
    "设备运维巡检人员",
    "能源管理决策查看者"
  ],
  "scenarios": [
    "快速浏览园区今日用电量、当前总功率与设备在线率",
    "查看重点设备的运行与检修状态",
    "核对运行摘要中的告警项、能耗目标与数据更新时间",
    "确认界面标注为演示数据、不接入真实业务源"
  ],
