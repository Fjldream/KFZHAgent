      "steps": [
        {
          "pageId": "overview-page",
          "regionId": "top-bar",
          "action": "阅读顶部栏，确认系统名称、页面标题与演示数据标识。",
          "result": "识别出当前为能源管理系统的园区能源总览，且数值为演示数据。",
