  "visualDirection": {
    "tone": "克制、清晰的工业能源管理风格，浅色底配青绿强调色，信息层级分明。",
    "colors": [
      "#f2f5f8 页面背景",
      "#1a1a2e 主文字",
      "#0f8a80 强调色",
      "#ffffff 卡片表面"
    ],
    "typography": "指标数值使用大号加粗字，标签与说明使用常规灰字，层级通过字号与字重区分。",
    "spacingAndSurfaces": "以 8/16/24/32 间距节奏排布，卡片使用白底、小圆角 8 至 12 与轻边界，区域间留白充足。"
  },
  "acceptanceScenarios": [
    "页面完整呈现顶部栏、侧栏、页面标题、三张指标卡、重点设备卡片、运行摘要卡片与页脚声明。",
    "三张指标卡显示 12,480 kWh、856 kW、98.6 % 的演示数值。",
    "重点设备卡片显示三台设备，且光伏逆变器状态为待检修。",
    "运行摘要显示当前告警 2 项、今日能耗目标 15,000 kWh、数据更新时间 14:30。",
    "侧栏菜单项与查看运行说明按钮仅静态展示，点击不触发任何跳转或动作。",
    "页脚出现“仅用于界面与工程生成验收 · 所有数值均为演示数据”声明。"
  ],
  "openQuestions": [
    "侧栏导航项在真实产品中点击后应发生什么？",
    "查看运行说明按钮实际应打开什么内容或触发什么交互？",
    "当前告警项数与今日用电量等指标的真实业务数据源是什么？",
    "设备的运行正常与待检修状态在真实产品中是否需要区分视觉样式？"
  ]
}