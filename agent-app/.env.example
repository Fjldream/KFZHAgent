# KF Solution Agent environment variables.
# Copy to .env and adjust per deployment (Linux x86 / Windows Server).

# Node environment: development | test | production
NODE_ENV=development

# Port for the API server
PORT=3000

# Shared only by API and worker. Generate independently for each deployment:
#   openssl rand -base64 32
# Never expose this value to the browser, model prompts, plan JSON, or logs.
KF_SERVER_PLAN_HMAC_KEY_BASE64=
