# KF Solution Agent 环境变量。
# 复制为 .env，并根据部署环境（Linux x86 / Windows Server）进行调整。

# Node 环境：development | test | production
NODE_ENV=development

# API 服务器端口
PORT=3000

# 仅供 API 和 worker 共用。本地启动时，将此文件复制为 `.env`，然后把 openssl rand -base64 32 的输出填入下方空值。绝不要向浏览器、模型提示词、计划 JSON 或日志暴露此值。
KF_SERVER_PLAN_HMAC_KEY_BASE64=
