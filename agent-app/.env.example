# KF Solution Agent 环境变量。
# 复制为 .env，并根据部署环境（Linux x86 / Windows Server）进行调整。

# Node 环境：development | test | production
NODE_ENV=development

# API 服务器端口
PORT=3000
# modified by jinlong.feng at 2026-10-27 Agent工作台迭代
# API 默认保留 0.0.0.0；本机独立 trial 强制使用 127.0.0.1。
API_HOST=0.0.0.0
# end

# 仅供 API 和 worker 共用。本地启动时，将此文件复制为 `.env`，然后把 openssl rand -base64 32 的输出填入下方空值。绝不要向浏览器、模型提示词、计划 JSON 或日志暴露此值。
KF_SERVER_PLAN_HMAC_KEY_BASE64=

# modified by jinlong.feng at 2026-10-20 Agent工作台迭代
# 新工作台写请求 Origin 白名单；填实际浏览器来源，生产环境不要保留无关地址。
AGENT_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
# agent-worker 必填：对应数据库中的租户 id，不是租户名称。
AGENT_TENANT_ID=
# API、agent-worker、build-worker 必须使用相同 DATABASE_URL、签名密钥和存储目录。
# 需同时启动 start:api、start:agent-worker、start:worker、start:web。
# 模型预算控制暂未启用；下方为 provider 配置，不表示已完成调用账本接线。
# 模型路由（仅服务端读取；浏览器提交的 endpoint / model / 价格一律不接受）
# 文本任务默认模型。留空则回落 deepseek-chat，保留既有生产模型不变
DEEPSEEK_MODEL=deepseek-chat
# OpenAI 兼容网关地址（尾部斜杠会被去掉）
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 单次请求完整 deadline（覆盖连接、响应体读取与 JSON 解析），毫秒
DEEPSEEK_TIMEOUT_MS=60000
# 单次上下文 token 上界；无可靠 tokenizer 时作为 admission 估算上界
DEEPSEEK_MAX_CONTEXT_TOKENS=64000
# 视觉任务专用模型。留空则视觉任务在服务端直接拒绝（MODEL_CAPABILITY_UNSUPPORTED），不降级为纯文本
DEEPSEEK_VISION_MODEL=
# modified by jinlong.feng at 2026-10-26 Agent工作台迭代
# 默认none；once允许同一视觉蓝图Run对完整但校验失败的新提案最多追加一次修复调用。仍需视觉准入、外发许可及独立蓝图确认。
KF_VISUAL_BLUEPRINT_REPAIR=none
# modified by jinlong.feng at 2026-10-26 Agent工作台迭代
# Explicit server opt-in; the signed engineering continuation must independently freeze once.
KF_VISUAL_SEMANTIC_REPAIR=none
# end
# end
# 价格表版本。留空则费用只能记为未知，不猜币种与单价
DEEPSEEK_PRICING_VERSION=
# modified by jinlong.feng at 2026-10-27 Agent工作台迭代
# 置 1 启用支持该策略的语义工程/视觉任务思考；意图识别保持现有关闭策略，默认不变。
# end
DEEPSEEK_THINKING=0
# provider 密钥。只放服务端环境，禁止进入日志、提示词、计划 JSON 或数据库
DEEPSEEK_API_KEY=
# end

# modified by jinlong.feng at 2026-10-21 Agent工作台迭代
# 默认关闭新 Run / 工作台执行；启用需同时设 true 并填写精确租户 UUID，逗号分隔。
# 空 allowlist 不开放任何租户；不支持 * 通配，也不接受浏览器提交权限配置。
AGENT_RUNS_V2=false
AGENT_WORKBENCH_V2=false
AGENT_FEATURE_TENANT_ALLOWLIST=
# modified by jinlong.feng at 2026-10-21 Agent工作台迭代
# 仅本地私有参考图上传，不代表视觉生成/图片外发已启用。先部署 202610210001 迁移再开启。
# modified by jinlong.feng at 2026-10-27 Agent工作台迭代
# 同时要求 RUNS/WORKBENCH 与精确租户准入；完整图片生成还须 VISION、租户管理员外发授权及本轮同意。
# end
AGENT_REFERENCE_UPLOADS_V1=false
# 每租户参考原图+派生图总配额，默认 1GiB；非正整数配置将拒绝上传。
AGENT_REFERENCE_QUOTA_BYTES=1073741824
# end
# modified by jinlong.feng at 2026-10-27 Agent工作台迭代
# 显式开放图生路径；仍要求 RUNS/WORKBENCH/精确租户、可用视觉模型、管理员许可和逐次同意。
AGENT_VISION_V1=false
# 下列功能仍未作为可用版开放；置 true 会被配置校验拒绝。预算控制继续暂缓。
# end
AGENT_USAGE_V2=false
AGENT_PROMPT_V2=false
AGENT_REGIONAL_EDIT_V1=false
AGENT_NATIVE_VERIFY_V1=false
# 停新受理：RUNS/WORKBENCH 设 false 后按部署方式加载配置；已有任务仍可查询、真实取消与排空。
# 多副本 API 配置须一致；不得通过重新启用旧 POST messages/resume 回退。
# end
