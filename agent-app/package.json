{
  "name": "kf-solution-agent",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run --workspace vitest.workspace.ts --maxWorkers=1",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "e2e": "playwright test",
    "e2e:report": "playwright show-report",
    "start:api": "pnpm exec vite-node -r apps/api -c tests/e2e/vite.e2e.config.ts apps/api/src/main.ts",
    "start:worker": "pnpm exec vite-node -r apps/worker -c tests/e2e/vite.e2e.config.ts apps/worker/src/run.ts",
    "start:web": "pnpm --filter web exec vite --host localhost --port 5173 --strictPort"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.15.47",
    "@types/node": "^24.0.0",
    "eslint": "^9.39.5",
    "prisma": "^6.19.3",
    "tsx": "^4.23.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^7.3.6",
    "vite-node": "^6.0.0",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3"
  }
}
