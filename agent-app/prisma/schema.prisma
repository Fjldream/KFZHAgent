// KF Solution Agent 的 Prisma schema。
// 任务 8：PostgreSQL schema、本地身份验证与租户隔离。
// 每个租户业务模型都携带 tenantId；租户范围名称和作业幂等键具有唯一索引。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  platform_admin
  tenant_admin
  member
}

enum JobStatus {
  QUEUED
  RUNNING
  VALIDATING
  SUCCEEDED
  FAILED
}

model Tenant {
  id         String              @id @default(uuid())
  name       String              @unique
  users      User[]
  workspaces SolutionWorkspace[]
  createdAt  DateTime            @default(now())
}

model User {
  id                 String        @id @default(uuid())
  tenantId           String
  tenant             Tenant        @relation(fields: [tenantId], references: [id])
  username           String
  passwordHash       String
  role               UserRole
  mustChangePassword Boolean       @default(true)
  lockedUntil        DateTime?
  sessions           UserSession[]
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@unique([tenantId, username])
}

model UserSession {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime  @default(now())
  revokedAt  DateTime?

  @@index([userId])
  @@index([expiresAt])
}

model SolutionWorkspace {
  id                String   @id @default(uuid())
  tenantId          String
  tenant            Tenant   @relation(fields: [tenantId], references: [id])
  name              String
  description       String?
  mode              String   @default("new") // "new" (生成的) | "upload" (导入的源)
  generationWorkflow String  @default("legacy") // “legacy” | “module-v1” | “creative-v2”; 由服务器所有，从不由模型/用户创建
  currentRevisionId String? // 只有在验证通过后才可使用
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  assets            WorkspaceAsset[]

  @@unique([tenantId, name])
}

model Conversation {
  id          String   @id @default(uuid())
  tenantId    String
  workspaceId String
  title       String
  summary     String?
  turnFence   ConversationTurnFence?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId, workspaceId])
}

/// 持久化的故障关闭标记，仅在有界 SSE 清理期限前无法确认图取消时使用。所属 API 进程通过一个独立的会话咨询锁证明存活；任何隔离标记记录都不会占用 PostgreSQL 连接池客户端。
model ConversationTurnFence {
  conversationId String       @id
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  ownerId        String
  leaseId        String       @unique
  state          String       @default("PENDING")
  fencedAt       DateTime     @default(now())

  @@index([ownerId])
}

/// 短期、一次性的制品下载令牌（任务 11）。每个令牌只存储 SHA-256 哈希；明文令牌只向调用方返回一次。`usedAt` 保证只能使用一次；`expiresAt` 限制有效期。
model DownloadToken {
  id         String    @id @default(uuid())
  tenantId   String
  userId     String
  artifactId String
  tokenHash  String    @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([tenantId, expiresAt])
}

model Message {
  id             String   @id @default(uuid())
  tenantId       String
  conversationId String
  role           String
  content        String
  createdAt      DateTime @default(now())

  @@index([tenantId, conversationId])
}

model ChangeRequest {
  id          String   @id @default(uuid())
  tenantId    String
  workspaceId String
  title       String
  status      String   @default("OPEN")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId, workspaceId])
}

model ChangePlan {
  id              String   @id @default(uuid())
  tenantId        String
  workspaceId     String
  changeRequestId String?
  planHash        String
  plan            Json?
  createdAt       DateTime @default(now())

  @@index([tenantId, workspaceId])
}

model SolutionRevision {
  id               String   @id @default(uuid())
  tenantId         String
  workspaceId      String
  changePlanId     String?
  revisionNumber   Int      @default(1)
  kind             String   @default("built") // "initial" | "source" | "built" | "rollback"
  parentRevisionId String? // 不可变的链节；回滚点指向历史修订
  state            Json?
  createdAt        DateTime @default(now())

  @@index([tenantId, workspaceId])
}

model DomainProjectRevision {
  id                 String   @id @default(uuid())
  tenantId           String
  solutionRevisionId String
  projectKey         String   @default("kingclient")
  domainKind         String
  kind               String   @default("client-package") // "source-package" | "client-package"
  mediaType          String   @default("application/octet-stream")
  fileExtension      String   @default(".gz")
  packageHash        String?
  packageUrl         String?
  createdAt          DateTime @default(now())

  @@unique([tenantId, solutionRevisionId, projectKey])
  @@index([tenantId, solutionRevisionId])
}

model BuildJob {
  id             String    @id @default(uuid())
  tenantId       String
  workspaceId    String
  baseRevisionId String
  changePlanId   String
  planHash       String
  projectKey     String    @default("kingclient")
  domainKind     String
  idempotencyKey String    @unique
  status         JobStatus
  leaseOwner     String?
  leaseExpiresAt DateTime?
  attemptCount   Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status, leaseExpiresAt, createdAt, tenantId, workspaceId])
  @@index([tenantId, status, leaseExpiresAt, createdAt, workspaceId])
  @@index([tenantId, workspaceId])
}

/// 用于有界跨租户构建调度的持续轮转游标。
model BuildSchedulerCursor {
  id           Int      @id
  lastTenantId String   @default("")
  updatedAt    DateTime @updatedAt
}

model Artifact {
  id                        String   @id @default(uuid())
  tenantId                  String
  buildJobId                String
  solutionRevisionId        String?
  creativeArtifactHash      String?
  nativeMaterializationHash String?
  kind                      String
  mediaType                 String   @default("application/octet-stream")
  fileExtension             String   @default(".gz")
  storageKey                String
  sizeBytes                 Int?
  sha256                    String?
  createdAt                 DateTime @default(now())

  @@index([tenantId, buildJobId])
  @@index([tenantId, solutionRevisionId])
}

/// 租户和工作空间范围内的逻辑资产。`storageKey` 始终为服务器私有信息；它绝不会进入模型上下文或 Web 目录响应。
model WorkspaceAsset {
  id          String   @id @default(uuid())
  tenantId    String
  workspaceId String
  type        String
  name        String
  mediaType   String
  storageKey  String
  sha256      String
  sizeBytes   Int
  width       Int?
  height      Int?
  tags        Json
  createdAt   DateTime @default(now())
  workspace   SolutionWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([tenantId, workspaceId, sha256])
  @@index([tenantId, workspaceId])
}

model ValidationReport {
  id           String   @id @default(uuid())
  tenantId     String
  buildJobId   String?
  changePlanId String?
  outcome      String
  summary      String?
  details      Json?
  createdAt    DateTime @default(now())

  @@index([tenantId, buildJobId])
}

model AuditLog {
  id           String   @id @default(uuid())
  tenantId     String
  actorUserId  String?
  action       String
  resourceType String?
  resourceId   String?
  detail       Json?
  createdAt    DateTime @default(now())

  @@index([tenantId, createdAt])
}
