// Prisma schema for KF Solution Agent.
// Task 8: PostgreSQL Schema, Local Authentication, and Tenant Isolation.
// Every tenant business model carries a tenantId; unique indexes for
// tenant-scoped names and job idempotency keys.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  platform_admin
  tenant_admin
  member
}

enum JobStatus {
  QUEUED
  RUNNING
  VALIDATING
  SUCCEEDED
  FAILED
}

model Tenant {
  id         String              @id @default(uuid())
  name       String              @unique
  users      User[]
  workspaces SolutionWorkspace[]
  createdAt  DateTime            @default(now())
}

model User {
  id                 String        @id @default(uuid())
  tenantId           String
  tenant             Tenant        @relation(fields: [tenantId], references: [id])
  username           String
  passwordHash       String
  role               UserRole
  mustChangePassword Boolean       @default(true)
  lockedUntil        DateTime?
  sessions           UserSession[]
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@unique([tenantId, username])
}

model UserSession {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime  @default(now())
  revokedAt  DateTime?

  @@index([userId])
  @@index([expiresAt])
}

model SolutionWorkspace {
  id                String   @id @default(uuid())
  tenantId          String
  tenant            Tenant   @relation(fields: [tenantId], references: [id])
  name              String
  description       String?
  mode              String   @default("new") // "new" (generative) | "upload" (imported source)
  generationWorkflow String  @default("legacy") // "legacy" | "module-v1" | "creative-v2"; server-owned, never model/user-authored
  currentRevisionId String? // advanced only after validation passes
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  assets            WorkspaceAsset[]

  @@unique([tenantId, name])
}

model Conversation {
  id          String   @id @default(uuid())
  tenantId    String
  workspaceId String
  title       String
  summary     String?
  turnFence   ConversationTurnFence?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId, workspaceId])
}

/// Durable fail-closed marker used only when graph cancellation cannot be
/// confirmed before the bounded SSE cleanup deadline. The owning API process
/// proves liveness with one independent session advisory lock; no fence row
/// owns a PostgreSQL pool client.
model ConversationTurnFence {
  conversationId String       @id
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  ownerId        String
  leaseId        String       @unique
  fencedAt       DateTime     @default(now())

  @@index([ownerId])
}

/// Short-lived single-use artifact download tokens (Task 11). Only the
/// SHA-256 hash of each token is stored; the plaintext token is returned once
/// to the caller. `usedAt` guards single-use; `expiresAt` guards lifetime.
model DownloadToken {
  id         String    @id @default(uuid())
  tenantId   String
  userId     String
  artifactId String
  tokenHash  String    @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([tenantId, expiresAt])
}

model Message {
  id             String   @id @default(uuid())
  tenantId       String
  conversationId String
  role           String
  content        String
  createdAt      DateTime @default(now())

  @@index([tenantId, conversationId])
}

model ChangeRequest {
  id          String   @id @default(uuid())
  tenantId    String
  workspaceId String
  title       String
  status      String   @default("OPEN")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId, workspaceId])
}

model ChangePlan {
  id              String   @id @default(uuid())
  tenantId        String
  workspaceId     String
  changeRequestId String?
  planHash        String
  plan            Json?
  createdAt       DateTime @default(now())

  @@index([tenantId, workspaceId])
}

model SolutionRevision {
  id               String   @id @default(uuid())
  tenantId         String
  workspaceId      String
  changePlanId     String?
  revisionNumber   Int      @default(1)
  kind             String   @default("built") // "initial" | "source" | "built" | "rollback"
  parentRevisionId String? // immutable chain link; rollback points at the historical revision
  state            Json?
  createdAt        DateTime @default(now())

  @@index([tenantId, workspaceId])
}

model DomainProjectRevision {
  id                 String   @id @default(uuid())
  tenantId           String
  solutionRevisionId String
  projectKey         String   @default("kingclient")
  domainKind         String
  kind               String   @default("client-package") // "source-package" | "client-package"
  mediaType          String   @default("application/octet-stream")
  fileExtension      String   @default(".gz")
  packageHash        String?
  packageUrl         String?
  createdAt          DateTime @default(now())

  @@unique([tenantId, solutionRevisionId, projectKey])
  @@index([tenantId, solutionRevisionId])
}

model BuildJob {
  id             String    @id @default(uuid())
  tenantId       String
  workspaceId    String
  baseRevisionId String
  changePlanId   String
  planHash       String
  projectKey     String    @default("kingclient")
  domainKind     String
  idempotencyKey String    @unique
  status         JobStatus
  leaseOwner     String?
  leaseExpiresAt DateTime?
  attemptCount   Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status, leaseExpiresAt])
  @@index([tenantId, workspaceId])
}

model Artifact {
  id                        String   @id @default(uuid())
  tenantId                  String
  buildJobId                String
  solutionRevisionId        String?
  creativeArtifactHash      String?
  nativeMaterializationHash String?
  kind                      String
  mediaType                 String   @default("application/octet-stream")
  fileExtension             String   @default(".gz")
  storageKey                String
  sizeBytes                 Int?
  sha256                    String?
  createdAt                 DateTime @default(now())

  @@index([tenantId, buildJobId])
  @@index([tenantId, solutionRevisionId])
}

/// Tenant- and workspace-scoped logical assets. `storageKey` remains server
/// private; it is never part of model context or the web catalog response.
model WorkspaceAsset {
  id          String   @id @default(uuid())
  tenantId    String
  workspaceId String
  type        String
  name        String
  mediaType   String
  storageKey  String
  sha256      String
  sizeBytes   Int
  width       Int?
  height      Int?
  tags        Json
  createdAt   DateTime @default(now())
  workspace   SolutionWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([tenantId, workspaceId, sha256])
  @@index([tenantId, workspaceId])
}

model ValidationReport {
  id           String   @id @default(uuid())
  tenantId     String
  buildJobId   String?
  changePlanId String?
  outcome      String
  summary      String?
  details      Json?
  createdAt    DateTime @default(now())

  @@index([tenantId, buildJobId])
}

model AuditLog {
  id           String   @id @default(uuid())
  tenantId     String
  actorUserId  String?
  action       String
  resourceType String?
  resourceId   String?
  detail       Json?
  createdAt    DateTime @default(now())

  @@index([tenantId, createdAt])
}
